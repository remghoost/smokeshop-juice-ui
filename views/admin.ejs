<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Vape Menu</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/admin.css">
    <script>
        // Apply the saved theme before paint to avoid a flash of the wrong theme
        if (document.cookie.split('; ').some(function (c) { return c === 'theme=dark'; })) {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body>
    <%- include('partials/nav', { active: 'admin', showScanMode: true }) %>

    <h1>Menu Management</h1>

    <div class="type-tabs">
        <a href="/" class="type-tab <%= type === 'juice' ? 'active' : '' %>">Juices</a>
        <a href="/?type=disposable" class="type-tab <%= type === 'disposable' ? 'active' : '' %>">Disposables</a>
    </div>

    <div id="scan-status" class="scan-status hidden"></div>

    <% if (typeof message !== 'undefined' && message) { %>
        <div class="alert <%= message.type === 'error' ? 'alert-error' : 'alert-success' %>">
            <%= message.text %>
        </div>
    <% } %>

    <div class="main-layout">
    <div class="main-content">
    <div class="form-container">
        <form id="juice-form" action="/add-juice" method="POST" class="form-grid">
            <input type="hidden" name="id" id="juice-id" value="">
            <input type="hidden" name="type" id="product-type" value="<%= type %>">
            <div class="form-group">
                <label for="brand">Brand</label>
                <div style="display: flex; gap: 5px;">
                    <select name="brand_id" id="brand" required>
                        <option value="">-- Select Brand --</option>
                        <% brands.forEach(brand => { %>
                            <option value="<%= brand.id %>"><%= brand.name %></option>
                        <% }) %>
                    </select>
                    <button type="button" onclick="addNewBrand()" class="btn-secondary" title="Add New Brand">+</button>
                </div>
            </div>
            <div class="form-group">
                <label for="flavor">Flavor</label>
                <input type="text" name="flavor" id="flavor" required placeholder="e.g. Peach Pear">
            </div>
            <% if (type === 'juice') { %>
            <div class="form-group">
                <label for="mg">MG Level</label>
                <select name="mg" id="mg" required>
                    <option value="">-- Select MG --</option>
                    <option value="0">0</option>
                    <option value="3">3</option>
                    <option value="6">6</option>
                    <option value="25">25</option>
                    <option value="35">35</option>
                    <option value="50">50</option>
                    <option value="55">55</option>
                </select>
            </div>
            <% } else { %>
            <div class="form-group">
                <label for="mg">MG Level</label>
                <input type="text" value="50mg (fixed)" disabled>
            </div>
            <% } %>
            <div class="form-group">
                <label for="barcode">Barcode <span class="hint">(optional - scan to fill)</span></label>
                <input type="text" name="barcode" id="barcode" placeholder="Scan or type barcode">
            </div>
            <button type="submit" id="juice-submit-btn" class="btn-primary"><%= type === 'disposable' ? 'Add Disposable' : 'Add Juice' %></button>
            <button type="button" id="juice-cancel-btn" class="btn-secondary hidden" onclick="cancelEdit()">Cancel</button>
        </form>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th onclick="sortTable(0)">Brand</th>
                    <th onclick="sortTable(1)">Flavor</th>
                    <th onclick="sortTable(2)">MG</th>
                    <th onclick="sortTable(3)">Stock</th>
                    <th>Barcode</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% juices.forEach(juice => { %>
                    <tr class="<%= juice.active ? '' : 'row-inactive' %>"
                        data-id="<%= juice.id %>"
                        data-brand-id="<%= juice.brand_id %>"
                        data-flavor="<%= juice.flavor %>"
                        data-mg="<%= juice.mg %>"
                        data-barcode="<%= juice.barcode || '' %>">
                        <td data-label="Brand"><%= juice.brand_name %></td>
                        <td data-label="Flavor"><%= juice.flavor %></td>
                        <td data-label="MG"><%= juice.mg %>mg</td>
                        <td data-label="Stock">
                            <div class="stock-controls">
                                <button type="button" class="stock-btn" onclick="adjustStock('<%= juice.id %>', -1)" title="Sell one (decrease stock)">−</button>
                                <input type="number" min="0" class="stock-input" data-id="<%= juice.id %>" value="<%= juice.stock %>"
                                       onchange="setStock('<%= juice.id %>', this.value)" title="Set stock directly">
                                <button type="button" class="stock-btn" onclick="adjustStock('<%= juice.id %>', 1)" title="Add one (increase stock)">+</button>
                            </div>
                        </td>
                        <td data-label="Barcode">
                            <% if (juice.barcode) { %>
                                <span class="barcode-yes">Yes</span>
                            <% } else { %>
                                <button type="button" class="btn-secondary barcode-btn" onclick="startBarcodeAssign('<%= juice.id %>')" title="Scan a barcode to assign it to this juice">Add</button>
                            <% } %>
                        </td>
                        <td data-label="Actions">
                            <div class="action-buttons">
                                <button onclick="toggleJuice('<%= juice.id %>')"
                                        class="<%= juice.active ? 'btn-secondary' : 'btn-success' %>">
                                    <%= juice.active ? 'Disable' : 'Enable' %>
                                </button>
                                <button onclick="startEdit('<%= juice.id %>')" class="btn-secondary" title="Edit brand, flavor, mg, or barcode">Edit</button>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    </div><!-- /.main-content -->

    <aside class="sales-panel">
        <div class="sales-panel-header">
            <h2>Today's Sales</h2>
            <span id="sales-total" class="sales-total">0</span>
        </div>
        <div id="sales-list" class="sales-list">
            <p class="sales-empty">No sales yet today.</p>
        </div>
        <a href="/sales" class="sales-link">View full sales report →</a>
    </aside>
    </div><!-- /.main-layout -->

    <script src="/js/theme.js"></script>
    <script src="/js/admin.js"></script>
</body>
</html>
