<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Vape Menu</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/admin.css">
    <script>
        // Apply the saved theme before paint to avoid a flash of the wrong theme
        if (document.cookie.split('; ').some(function (c) { return c === 'theme=dark'; })) {
            document.documentElement.classList.add('dark');
        }
        // Apply the saved scan mode before paint so the input menu is hidden in Sell Mode
        if ((sessionStorage.getItem('scanMode') || 'sell') === 'sell') {
            document.documentElement.classList.add('sell-mode');
        }
    </script>
</head>
<body>
    <%- include('partials/nav', { active: 'admin' }) %>

    <h1>Menu Management</h1>

    <div id="scan-status" class="scan-status hidden"></div>

    <div id="input-menu">
        <div class="type-tabs" id="type-filter" data-initial="<%= type === 'disposable' ? 'disposable' : 'juice' %>">
            <button type="button" class="type-tab" data-filter="disposable" onclick="applyFilter('disposable')">Disposables</button>
            <button type="button" class="type-tab" data-filter="juice" onclick="applyFilter('juice')">Juices</button>
            <button type="button" class="type-tab cam-btn" onclick="Camera.open()" title="Scan the barcode with the camera, then photograph the box front to auto-fill the form">📷 Add via camera</button>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert <%= message.type === 'error' ? 'alert-error' : 'alert-success' %>">
                <%= message.text %>
            </div>
        <% } %>
    </div>

    <div class="main-layout">
    <div class="main-content" id="input-content">
    <div class="form-container">
        <form id="juice-form" action="/add-juice" method="POST" class="form-grid">
            <input type="hidden" name="id" id="juice-id" value="">
            <input type="hidden" name="type" id="product-type" value="juice">
            <div class="form-group">
                <label for="brand">Brand</label>
                <div style="display: flex; gap: 5px;">
                    <select name="brand_id" id="brand" required>
                        <option value="">-- Select Brand --</option>
                        <% brands.forEach(brand => { %>
                            <option value="<%= brand.id %>" data-type="<%= brand.type %>"><%= brand.name %></option>
                        <% }) %>
                    </select>
                    <button type="button" onclick="addNewBrand()" class="btn-secondary" title="Add New Brand">+</button>
                </div>
                <div id="cam-brand-hint" class="cam-brand-hint hidden"></div>
            </div>
            <div class="form-group">
                <label for="flavor">Flavor</label>
                <input type="text" name="flavor" id="flavor" required placeholder="e.g. Peach Pear">
            </div>
            <div class="form-group" id="mg-group">
                <label for="mg">MG Level</label>
                <select name="mg" id="mg" required>
                    <option value="">-- Select MG --</option>
                    <option value="0">0</option>
                    <option value="3">3</option>
                    <option value="6">6</option>
                    <option value="25">25</option>
                    <option value="35">35</option>
                    <option value="50">50</option>
                    <option value="55">55</option>
                </select>
                <input type="text" id="mg-fixed" value="50mg (fixed)" disabled class="hidden">
            </div>
            <div class="form-group">
                <label for="barcode">Barcode <span class="hint">(optional - scan to fill)</span></label>
                <input type="text" name="barcode" id="barcode" placeholder="Scan or type barcode">
            </div>
            <button type="submit" id="juice-submit-btn" class="btn-primary">Add Juice</button>
            <button type="button" id="juice-cancel-btn" class="btn-secondary hidden" onclick="cancelEdit()">Cancel</button>
        </form>
    </div>

    <div class="table-container">
        <table id="juice-table">
            <thead>
                <tr>
                    <th onclick="sortTable(0)">Brand</th>
                    <th onclick="sortTable(1)">Flavor</th>
                    <th onclick="sortTable(2)">MG</th>
                    <th onclick="sortTable(3)">Stock</th>
                    <th>Barcode</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% juices.forEach(juice => { %>
                    <tr class="<%= juice.active ? '' : 'row-inactive' %>"
                        data-id="<%= juice.id %>"
                        data-type="<%= juice.type %>"
                        data-brand-id="<%= juice.brand_id %>"
                        data-flavor="<%= juice.flavor %>"
                        data-mg="<%= juice.mg %>"
                        data-barcode="<%= juice.barcode || '' %>">
                        <td><%= juice.brand_name %></td>
                        <td><%= juice.flavor %></td>
                        <td><%= juice.mg %>mg</td>
                        <td>
                            <div class="stock-controls">
                                <button type="button" class="stock-btn" onclick="adjustStock('<%= juice.id %>', -1)" title="Sell one (decrease stock)">−</button>
                                <input type="number" min="0" class="stock-input" data-id="<%= juice.id %>" value="<%= juice.stock %>"
                                       onchange="setStock('<%= juice.id %>', this.value)" title="Set stock directly">
                                <button type="button" class="stock-btn" onclick="adjustStock('<%= juice.id %>', 1)" title="Add one (increase stock)">+</button>
                            </div>
                        </td>
                        <td>
                            <% if (juice.barcode) { %>
                                <span class="barcode-yes">Yes</span>
                            <% } else { %>
                                <button type="button" class="btn-secondary barcode-btn" onclick="startBarcodeAssign('<%= juice.id %>')" title="Scan a barcode to assign it to this juice">Add</button>
                            <% } %>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <button onclick="toggleJuice('<%= juice.id %>')"
                                        class="<%= juice.active ? 'btn-secondary' : 'btn-success' %>">
                                    <%= juice.active ? 'Disable' : 'Enable' %>
                                </button>
                                <button onclick="startEdit('<%= juice.id %>')" class="btn-secondary" title="Edit brand, flavor, mg, or barcode">Edit</button>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    </div><!-- /.main-content -->

    <aside class="sales-panel">
        <div class="sales-panel-header">
            <h2>Today's Sales</h2>
            <span id="sales-total" class="sales-total">0</span>
        </div>
        <div id="sales-list" class="sales-list">
            <p class="sales-empty">No sales yet today.</p>
        </div>
        <button type="button" class="btn-success sell-cam-btn" onclick="Camera.openSell()"
                title="Scan a barcode with the phone camera to sell one unit">📷 Use camera to sell</button>
        <a href="/sales" class="sales-link">View full sales report →</a>
    </aside>
    </div><!-- /.main-layout -->

    <!-- Camera data-entry modal (mobile, Input Mode) -->
    <div id="camera-modal" class="camera-modal hidden" role="dialog" aria-modal="true" aria-label="Add product via camera">
        <div class="camera-modal-box">
            <button type="button" class="camera-close" onclick="Camera.close()" aria-label="Close camera">✕</button>

            <div id="cam-step-scan" class="cam-step">
                <h2>1. Scan the barcode</h2>
                <p class="cam-hint">Point the camera at the product's barcode. It captures automatically.</p>
            </div>

            <div id="cam-step-sell" class="cam-step hidden">
                <h2>Scan to sell</h2>
                <p class="cam-hint">Point the camera at the product's barcode. It sells one unit automatically.</p>
                <div id="cam-sell-busy" class="cam-busy hidden">Selling…</div>
                <div id="cam-sell-result" class="cam-ocr-result hidden"></div>
                <div id="cam-sell-actions" class="cam-shutter-row hidden">
                    <button type="button" class="btn-primary cam-shutter" onclick="Camera.scanNext()">📷 Scan next</button>
                </div>
            </div>

            <div id="cam-step-stock" class="cam-step hidden">
                <h2>Add to stock</h2>
                <p class="cam-hint" id="cam-stock-label"></p>
                <p class="cam-hint">Current stock: <span id="cam-stock-current" class="barcode-value"></span></p>
                <div class="cam-stock-controls">
                    <button type="button" class="cam-stock-btn" onclick="Camera.stockAdjust(-1)">−</button>
                    <input type="number" id="cam-stock-qty" min="1" value="1" inputmode="numeric">
                    <button type="button" class="cam-stock-btn" onclick="Camera.stockAdjust(1)">+</button>
                </div>
                <div id="cam-stock-busy" class="cam-busy hidden">Updating…</div>
                <div id="cam-stock-result" class="cam-ocr-result hidden"></div>
                <div class="cam-shutter-row">
                    <button type="button" class="btn-primary cam-shutter" onclick="Camera.confirmStock()">Add to stock</button>
                </div>
                <button type="button" class="btn-secondary" onclick="Camera.scanNext()">Scan a different product</button>
            </div>

            <div id="cam-step-photo" class="cam-step hidden">
                <h2>2. Photograph the box front</h2>
                <p class="cam-hint">Barcode: <span id="cam-barcode-value" class="barcode-value"></span></p>
                <p class="cam-hint">Aim at the front of the box (brand, flavor, and mg visible), then tap the shutter.</p>
            </div>

            <div id="cam-step-result" class="cam-step hidden">
                <h2>Reading the box…</h2>
                <img id="cam-photo-preview" class="cam-photo-preview" alt="Box photo">
                <div id="cam-busy" class="cam-busy">Reading the box…</div>
                <div id="cam-ocr-result" class="cam-ocr-result hidden"></div>
                <button type="button" class="btn-secondary" onclick="Camera.retakePhoto()">Retake photo</button>
            </div>

            <!-- Shared live viewfinder (visible in the scan + photo steps) -->
            <div id="cam-viewfinder" class="cam-viewfinder">
                <video id="camera-video" playsinline muted></video>
                <div id="cam-scanline" class="cam-scanline"></div>
                <canvas id="cam-box-overlay" class="cam-box-overlay"></canvas>
                <button type="button" id="cam-torch-btn" class="cam-torch-btn hidden" onclick="Camera.toggleTorch()" aria-label="Toggle torch">🔦</button>
            </div>
            <div id="cam-shutter-row" class="cam-shutter-row hidden">
                <button type="button" class="btn-primary cam-shutter" onclick="Camera.snapPhoto()">📸 Take photo</button>
            </div>
            <div id="cam-error" class="cam-error hidden"></div>
        </div>
    </div>

    <script src="/vendor/zxing-library.min.js"></script>
    <script src="/vendor/zxing-browser.min.js"></script>
    <script src="/js/theme.js?v=2"></script>
    <script src="/js/admin.js?v=2"></script>
    <script src="/js/camera.js?v=2"></script>
</body>
</html>
