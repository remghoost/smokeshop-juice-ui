<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Printable Menu - Vape Juices</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/print.css">
    <script>
        // Apply the saved theme before paint to avoid a flash of the wrong theme
        if (document.cookie.split('; ').some(function (c) { return c === 'theme=dark'; })) {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body>
    <%- include('partials/nav', { active: 'print' }) %>
    <div class="no-print">
        <button onclick="window.print()" class="print-btn">Print Menu</button>
    </div>

    <div class="menu-container">
        <%
        let currentMg = null;
        let currentBrand = null;

        juices.forEach(juice => {
            if (juice.mg !== currentMg) {
                currentMg = juice.mg;
                currentBrand = null; // Reset brand when MG changes
        %>
                <div class="mg-section">
                    <div class="mg-header"><%= currentMg %>mg</div>
        <% } %>

        <% if (juice.brand_name !== currentBrand) { %>
            <% currentBrand = juice.brand_name; %>
            <div class="brand-group">
                <span class="brand-header"><%= currentBrand %></span>
                <ul class="flavor-list">
        <% } %>
                <li class="flavor-item"><%= juice.flavor %></li>
        <%
        });
        %>
    </div>
    <script src="/js/theme.js"></script>
</body>
</html>
